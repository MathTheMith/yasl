#!yasl_linux_x64

(! !)
(# 1 != ?( "wrong number of parameters\n" print 1 exit) )

(= 0 < ? ("parameter must be positive integer\n" print 2 exit) )

// count
(0 -)		// init count
1			// init acc
(2 !^)		// save acc

(= 0 >)			// count > 0
@(
	=
	(3 ^)		// load acc
	*			// mul acc
	(2 !^)		// save acc
	(1 -)		// count -= 1
	(= 0 >)		// count > 0
)

!			// drop count
print
"\n"
print
